		setProductOptions([]);
		setProductSearchPage(0);
		setProductSearchTerm("");
		setTotalProducts(0);
		setTableSelectedPatient(null);
		setTablePatientOptions([]);
		setPatientFilter(null);
		setPatientSearchTerm("");
		setPatientTableSearchTerm("");
	};

	const handleFormSubmit = async () => {
		try {
