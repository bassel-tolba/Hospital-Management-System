											.filter(([header]) => header !== "key") // Filter out the "key" column
											.map(([header, cell], index) => (
												<TableCell key={index}>{cell != null ? cell.toString() : ""}</TableCell>
											))}
									</TableRow>
								))}
							</TableBody>
