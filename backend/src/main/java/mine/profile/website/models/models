    public Unit getUnit() {
        return getCurrentAdmission()
                .map(admission -> admission.getBed().getRoom().getUnit())
                .orElse(null);
    }

    public Room getRoom() {
        return getCurrentAdmission().map(admission -> admission.getBed().getRoom()).orElse(null);
    }

