            EntityMapper entityMapper, ProcedureLogService procedureLogService) {
        this.billingRepository = billingRepository;
        this.patientRepository = patientRepository;
        this.entityMapper = entityMapper;
        this.procedureLogService = procedureLogService;
    }

    @Transactional
    public BillingDTO createBilling(BillingDTO billingDTO) {
        Patient patient = patientRepository.findById(billingDTO.getPatientId())
                .orElseThrow(() -> new IllegalArgumentException("Invalid Patient ID: " + billingDTO.getPatientId()));

        Billing billing = entityMapper.toEntity(billingDTO, patient);
        billing.setBillDate(LocalDateTime.now());

        Billing savedBilling = billingRepository.save(billing);
        updateBillingTotal(savedBilling.getId());
        return entityMapper.toDto(savedBilling);
    }

    @Transactional
    public BillingDTO findById(Long id) {
        return entityMapper.toDto(billingRepository.findById(id)
                .orElseThrow(() -> new IllegalArgumentException("Invalid Billing ID: " + id)));
    }

    @Transactional
    public BillingDTO updateBillingTotal(Long billingId) {
        Billing billing = billingRepository.findById(billingId)
                .orElseThrow(() -> new IllegalArgumentException("Invalid Billing ID: " + billingId));

        List<ProcedureLog> procedureLogs = procedureLogService.findByBillingId(billingId);

        BigDecimal totalAmount = procedureLogs.stream().map(procedureLog -> {
            BigDecimal totalLogPrice = BigDecimal.valueOf(0);
            if (procedureLog.getProcedure() != null) {
                totalLogPrice = totalLogPrice.add(BigDecimal.valueOf(procedureLog.getProcedure().getPrice()));
            }
            if (procedureLog.getMedicationAdministration() != null) {
                totalLogPrice = totalLogPrice.add(procedureLog.getMedicationAdministration().getCalculatedPrice());
            }
            return totalLogPrice;
        })
                .reduce(BigDecimal.ZERO, BigDecimal::add);

        billing.setTotalAmount(totalAmount.doubleValue());

        Billing savedBilling = billingRepository.save(billing);
        return entityMapper.toDto(savedBilling);
    }

    @Transactional
    public List<BillingDTO> findAll() {
        return entityMapper.toBillingDtoList(billingRepository.findAll());
    }

    @Transactional
    public void deleteById(Long id) {
        billingRepository.deleteById(id);
    }
}
