    }

    public NurseDTO createNurse(NurseDTO nurseDTO) {
        Nurse nurse = NurseDTO.toEntity(nurseDTO);
        Nurse createdNurse = nurseRepository.save(nurse);
        return NurseDTO.toDto(createdNurse);
