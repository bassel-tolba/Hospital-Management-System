package mine.profile.website.service;

import java.time.LocalDateTime;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.Iterator;
import java.util.List;
import java.util.Map;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import mine.profile.website.dtos.VitalSignDTO;
import mine.profile.website.models.Patient;
import mine.profile.website.models.Unit;
import mine.profile.website.models.UnitType;
import mine.profile.website.repository.PatientRepository;
import mine.profile.website.repository.UnitRepository;
import mine.profile.website.repository.VitalSignRepository;

@Service
public class ScheduleService {

    @Autowired
    private VitalSignRepository vitalSignRepository;
    @Autowired
    private PatientRepository patientRepository;
    @Autowired
    private UnitRepository unitRepository;

    public List<Map<String, Object>> generatePatientSchedule(Patient patient) {
        List<Map<String, Object>> patientSchedule = new ArrayList<>();
        LocalDateTime now = LocalDateTime.now();
        LocalDateTime vitalSignsTime = now;

        Map<String, Object> vitalSignsTask = new HashMap<>();
        vitalSignsTask.put("task", "Record Vital Signs");
        vitalSignsTask.put("scheduledTime", vitalSignsTime);
        Map<String, Object> patientInfo = new HashMap<>();
        patientInfo.put("id", patient.getId());
        patientInfo.put("firstName", patient.getFirstName());
        patientInfo.put("lastName", patient.getLastName());
        patientInfo.put("dateOfBirth", patient.getDateOfBirth());
        patientInfo.put("gender", patient.getGender());
        patientSchedule.add(vitalSignsTask);
        vitalSignsTask.put("patient", patientInfo);
        return patientSchedule;
    }

    public List<Map<String, Object>> checkAndRemoveRecordedVitalSignSchedule(List<Map<String, Object>> patientSchedule,
            Patient patient, Long nurseId) {

        if (patientSchedule == null || patientSchedule.isEmpty())
            return patientSchedule;

        LocalDateTime twoHoursAgo = LocalDateTime.now().minusHours(2);
        LocalDateTime twoHoursLater = LocalDateTime.now().plusHours(2);

        // Using iterator to allow removal during iteration
        Iterator<Map<String, Object>> iterator = patientSchedule.iterator();
        while (iterator.hasNext()) {
            Map<String, Object> scheduleItem = iterator.next();
            if ("Record Vital Signs".equals(scheduleItem.get("task"))) {
                LocalDateTime scheduledTime = (LocalDateTime) scheduleItem.get("scheduledTime");
                // Fetch all vital signs for the patient, within our time window
                List<VitalSignDTO> vitalSigns = vitalSignRepository
                        .findByPatientIdAndTimestampBetween(patient.getId(), twoHoursAgo, twoHoursLater)
                        .stream().map(vitalSign -> {
                            VitalSignDTO vitalSignDTO = new VitalSignDTO();
                            vitalSignDTO.setId(vitalSign.getId());
                            vitalSignDTO.setTimestamp(vitalSign.getTimestamp());
                            vitalSignDTO.setPatientId(vitalSign.getPatient().getId());
                            return vitalSignDTO;

                        }).toList();

                // check if there is a vital sign record by a nurse on the given time
                for (VitalSignDTO vitalSignDTO : vitalSigns) {
                    if (vitalSignDTO.getTimestamp().isAfter(scheduledTime.minusHours(2)) &&
                            vitalSignDTO.getTimestamp().isBefore(scheduledTime.plusHours(2))) {
                        // delete the record
                        vitalSignRepository.deleteById(vitalSignDTO.getId());
                        iterator.remove();
                        break; // No need to check further vital sign records for the given schedule item
                    }
                }
            }
        }
        return patientSchedule;
    }

    public void generateSchedulesForAllUnits() {
        List<Unit> allUnits = unitRepository.findAll();

        for (Unit unit : allUnits) {
            List<Patient> patientsInUnit = patientRepository.findPatientsByUnitId(unit.getId());

            for (Patient patient : patientsInUnit) {
                List<Map<String, Object>> patientSchedule = generatePatientSchedule(patient);
                scheduleActivitiesForUnitType(unit.getUnitType(), patient);
            }
        }
    }

    @Transactional
    public void removeAndCreateSchedulesForAllUnits() {
        // First, remove all existing vital signs in the system
        List<Patient> allPatients = patientRepository.findAll();

        for (Patient patient : allPatients) {
            // Fetch all vital signs for the patient, within our time window
            List<VitalSignDTO> vitalSigns = vitalSignRepository.findByPatientId(patient.getId())
                    .stream().map(vitalSign -> {
                        VitalSignDTO vitalSignDTO = new VitalSignDTO();
                        vitalSignDTO.setId(vitalSign.getId());
                        vitalSignDTO.setTimestamp(vitalSign.getTimestamp());
                        vitalSignDTO.setPatientId(vitalSign.getPatient().getId());
                        return vitalSignDTO;

                    }).toList();

            // delete the record
            for (VitalSignDTO vitalSignDTO : vitalSigns)
                vitalSignRepository.deleteById(vitalSignDTO.getId());

        }
        // Now, generate new schedules for all units
        generateSchedulesForAllUnits();
    }

    private void scheduleActivitiesForUnitType(UnitType unitType, Patient patient) {
        switch (unitType) {
            case ICU:
            case CCU:
            case NICU:
            case EMERGENCY:
                generateScheduleEvery(1, patient); // Every 15 minutes
                break;
            case WARD:
            case GENERAL_MEDICAL:
            case GENERAL_SURGICAL:
            case PEDIATRIC:
            case OBSTETRICS_GYNECOLOGY:
            case ORTHOPEDIC:
            case ONCOLOGY:
            case DIALYSIS:
            case PSYCHIATRIC:
            case NEUROLOGY:
            case PULMONARY:
            case GASTROENTEROLOGY:
            case OPHTHALMOLOGY:
            case ENT:
            case DERMATOLOGY:
            case REHABILITATION:
            case INFECTIOUS_DISEASE:
            case OPERATING_ROOM:
                generateScheduleEvery(4 * 60, patient); // Every 4 hours
                break;
            // Handle other unit types if needed
            default:
                break;
        }
    }

    private void generateScheduleEvery(int minutes, Patient patient) {
        // Get current time
        LocalDateTime now = LocalDateTime.now();
        LocalDateTime scheduledTime = now;

        // Schedule a vital sign task for the specified frequency
        while (scheduledTime.isBefore(now.plusDays(1))) {
            List<Map<String, Object>> patientSchedule = generatePatientSchedule(patient);
            checkAndRemoveRecordedVitalSignSchedule(patientSchedule, patient, 1L); // Assuming you always schedule it by
                                                                                   // a nurse.

            scheduledTime = scheduledTime.plusMinutes(minutes);
        }
    }
